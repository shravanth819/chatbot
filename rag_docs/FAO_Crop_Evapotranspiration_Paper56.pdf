    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
    xmlns:tiff="http://ns.adobe.com/tiff/1.0/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
   photoshop:LegacyIPTCDigest="79294520096DC356F67DBB509BB3063C"
   photoshop:Instructions="&amp;nbsp;"
   photoshop:City="Isinya"
   photoshop:Country="KENYA"
   photoshop:Headline="Global Rinderpest Eradication Programme (GREP)"
   photoshop:Credit="Â©FAO/Tony Karumba"
   photoshop:Source="FAO: photo-library@fao.org"
   photoshop:ColorMode="4"
   dc:format="application/vnd.adobe.photoshop"
   crs:AlreadyApplied="True"
   xmp:CreateDate="2013-05-28T09:58:34+02:00"
   xmp:ModifyDate="2013-05-28T10:55:39+02:00"
   xmp:MetadataDate="2013-05-28T10:55:39+02:00"
   xmp:CreatorTool="Adobe Photoshop CS5.1 Windows"
   xmpMM:InstanceID="xmp.iid:79AE79D373C7E2118275E5B7343ECFF8"
   xmpMM:DocumentID="xmp.did:78AE79D373C7E2118275E5B7343ECFF8"
   xmpMM:OriginalDocumentID="xmp.did:78AE79D373C7E2118275E5B7343ECFF8"
   tiff:ImageWidth="4156"
   tiff:ImageLength="2760"
   tiff:PhotometricInterpretation="2"
   tiff:Orientation="1"
   tiff:SamplesPerPixel="3"
   tiff:XResolution="3000000/10000"
   tiff:YResolution="3000000/10000"
   tiff:ResolutionUnit="2"
   exif:ExifVersion="0221"
   exif:ColorSpace="65535"
   exif:PixelXDimension="2008"
   exif:PixelYDimension="1333">
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">24711_8060</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">24 November 2010, Isinya - Two Maasai livestock owners whose herds have suffered from and sebsequently been vaccinated against rinderpest in the past, watch as their cattle graze near the village of Isinya, approximately 50 kilometres southwest of capital Nairobi. An ambitious global effort has brought Rinderpest, a deadly cattle plague, to the brink of extinction is ending all field activities, paving the way for official eradication of the disease.&amp;#xA;&amp;#xA;It would be the first time in history that humankind has succeeded in wiping out an animal disease in the wild, and only the second time, after smallpox in 1980, that a disease has been eliminated thanks to human efforts.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <xmpMM:History>
