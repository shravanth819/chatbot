q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6fad744d-fe5c-42f1-b567-e32ca02e6b28/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6fad744d-fe5c-42f1-b567-e32ca02e6b28/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6fad744d-fe5c-42f1-b567-e32ca02e6b28/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6fad744d-fe5c-42f1-b567-e32ca02e6b28/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6fad744d-fe5c-42f1-b567-e32ca02e6b28/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6fad744d-fe5c-42f1-b567-e32ca02e6b28&q;}},&q;_name&q;:&q;Análisis comparativo de las contribuciones determinadas a nivel nacional de América Latina y el Caribe&q;,&q;id&q;:&q;6fad744d-fe5c-42f1-b567-e32ca02e6b28&q;,&q;uuid&q;:&q;6fad744d-fe5c-42f1-b567-e32ca02e6b28&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;4c019918-4800-46f4-a9e0-7bad81b4f0e1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Jones, C.; Proaño, M.M.; Alvarado, A.;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;7920e9ce-99db-4158-a7db-fc4de504b2c7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Latin America and the Caribbean&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;f3ad7952-ea28-4aa8-9bc6-6c26891077f8&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T17:15:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;8979fb98-b6dd-4d2b-b3ce-3aef859abcd7&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T17:15:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;1be0fb7f-4dd9-4f37-941d-77e78d8c08a1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;0d264518-0f83-4f09-bdd4-36a3c5a67c07&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-14T17:10:13Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;78e0d08f-7404-436c-88ea-9c782d40e7da&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;En esta publicación se presenta un análisis integral de la FAO sobre el estado de los sistemas agroalimentarios en las contribuciones determinadas a nivel nacional de América Latina y el Caribe. Se examina el grado en que estas están contribuyendo a la transformación de los sistemas agroalimentarios resilientes al clima y con bajas emisiones. Asimismo, se presentan de forma concisa las metas nacionales de adaptación y mitigación, así como los objetivos y acciones en los sistemas agroalimentarios, incluidas las necesidades de financiamiento, tecnología y fortalecimiento de capacidades.Se analizaron un total de 33 contribuciones determinadas a nivel nacional de América Latina y el Caribe presentadas al registro de contribuciones determinadas a nivel nacional de la Convención Marco de las Naciones Unidas sobre el Cambio Climático hasta el 30 de diciembre de 2023. El análisis busca identificar tendencias y desafíos relacionados con los sistemas agroalimentarios, incluidos los impactos del cambio climático y las medidas de adaptación, mitigación, necesidades de apoyo, condiciones habilitantes para la acción climática, así como la inclusión y transparencia de la acción climática desde una perspectiva sectorial. Esta publicación se dirige principalmente a planificadores y responsables de políticas públicas involucrados en la planificación nacional sobre cambio climático y sistemas agroalimentarios, con el fin de promover la coherencia de políticas, la coordinación intersectorial y la participación de múltiples actores en la implementación de las contribuciones determinadas a nivel nacional a diferentes escalas. También resulta relevante para organizaciones internacionales, organizaciones no gubernamentales de desarrollo e instituciones financieras con mandato para apoyar resultados sostenibles, inclusivos y resilientes al clima en los sistemas agroalimentarios.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;8d07b0c7-980d-4e46-8c3f-c59d9fc8d31b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;125 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;d837a905-ba3c-430e-90f8-8d8918b4f845&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2706-607X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;bbf91c82-c8c2-402f-8a02-2af613e9481b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140760-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;f14bd1e0-64fe-43d0-9333-b8f5544d1364&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2227-4650&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;2c8e4f11-8cd5-4397-bd34-8a696fa3c7e7&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0136es&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;81027699-3bfd-4586-9742-a4808e882149&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Spanish&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;f07a584d-19c0-4e7c-a418-7fbc431a6f42&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;74a9abbd-e7e3-4d25-ba15-8a37c1a6cebe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Medio ambiente y gestión de recursos naturales documento de trabajo&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.numb