q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/ce338d15-a83b-4e09-992b-9d553fa6589c/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/ce338d15-a83b-4e09-992b-9d553fa6589c&q;}},&q;_name&q;:&q;General principles of food hygiene&q;,&q;id&q;:&q;ce338d15-a83b-4e09-992b-9d553fa6589c&q;,&q;uuid&q;:&q;ce338d15-a83b-4e09-992b-9d553fa6589c&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;024e2e3e-c039-4137-af76-7dafe63400f8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WHO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;ba183747-9ed8-424c-b3f1-821e4828c833&q;,&q;language&q;:null,&q;value&q;:&q;2025-03-18T11:22:11Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;55afbbcb-19f3-460b-9686-5adac72070bb&q;,&q;language&q;:null,&q;value&q;:&q;2025-03-18T11:22:11Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;cdde7f02-ddf3-425c-ac92-5d8480af9c94&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2023&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;61b2463b-64b6-4f88-993d-056dc011439f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-03-18T11:17:04Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;d7e0094d-6969-467f-8115-c9610091f77e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This document outlines the general principles that should be understood and followed by food business operators at all stages of the food chain and that provide a basis for competent authorities to oversee food safety and suitability.This edition contains a new annex which introduces tools to determine the critical control points in a hazard analysis and critical control point (HACCP) system.The term \&q;Codex Alimentarius\&q; is Latin and means \&q;food code”. Codex standards are international food texts, i.e. standards, codes of practice, codes of hygienic practice, guidelines and other recommendations, established to protect the health of the consumers and to ensure fair practices in the food trade. The collection of food standards and related texts adopted by the Codex Alimentarius Commission is known as the Codex Alimentarius.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e251236a-8d40-4169-b4a8-2c3be181d722&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;60 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;9eb75635-1e97-4c85-9868-7fbfc7396eb6&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cc6125en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.url&q;:[{&q;uuid&q;:&q;d2df997d-daf0-4486-a962-7da207377b09&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;http://www.fao.org/3/cc6125en/cc6125en.pdf&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;8d72eb38-3a39-4151-9301-6a1a96b9f8ae&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;0c691136-1459-4181-8461-dbea2eb3f5ed&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; WHO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;715d31d4-a39a-485d-85db-67543f219993&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;73ce0c79-ca5a-410f-9c7a-a0501d25392b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;General principles of food hygiene&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;d2db0186-b200-4855-b9f2-0665eaabe888&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Document&q;,&q;place&q;:0,&q;a