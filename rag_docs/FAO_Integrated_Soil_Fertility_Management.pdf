s&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c6ea1e38-f859-48f2-bcfe-43fcdc0d9522&q;}},&q;_name&q;:&q;Soil health and fertilizer&q;,&q;id&q;:&q;c6ea1e38-f859-48f2-bcfe-43fcdc0d9522&q;,&q;uuid&q;:&q;c6ea1e38-f859-48f2-bcfe-43fcdc0d9522&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;1bbb2286-4d56-4f60-9e41-8cc76c459415&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Jafari, A.; Le Cotty, T.; Tefft, J.;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;3fee247e-1d53-4e3a-9afd-7aa34bc8623a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Africa&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;ecc59a72-4aa9-4eef-a1e7-0c01997057a0&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-17T06:50:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;03d84c76-b962-45bd-a33b-a89b7aa032ad&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-17T06:50:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;903c2c48-eab6-40c2-9843-a7a3c3cddd45&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;44ae0cc8-353e-4ea4-ae38-27934ffe291d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-17T06:49:22Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;4118a0a8-6f6e-4e0c-b16a-cf06ecd235d3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Agriculture is a cornerstone of sub-Saharan Africa&s;s economy, yet it falls short of meeting regional food security and nutrition needs. Low productivity is widespread, particularly where soil quality and health have been degraded. Fertilizers can play a key role in breaking this cycle, but only where conditions support their effective use. This report by the FAO Investment Centre, in partnership with Agrinatura and the European Union, examines the structural, market and agronomic constraints to improving soil health and fertilizer use, and assesses the tools and options available to address them. It finds that raising yields will require increased mineral fertilizer use, complemented by proven agroecological and soil health management approaches. The evidence points away from uniform solutions and traditional approaches that have favoured fertilizer subsidies to limited effect, and shows that policies and programmes must be tailored to the agronomic realities and socioeconomic circumstances of different smallholder contexts. This report is part of the Directions in Investment series under the FAO Investment Centre&s;s Innovation and Knowledge for Investment (IK4I) programme.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc