dge.fao.org/server/api/core/items/f25f04f1-4045-43f5-84e4-247126115b1e/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f25f04f1-4045-43f5-84e4-247126115b1e&q;}},&q;_name&q;:&q;2026年世界渔业和水产养殖状况&q;,&q;id&q;:&q;f25f04f1-4045-43f5-84e4-247126115b1e&q;,&q;uuid&q;:&q;f25f04f1-4045-43f5-84e4-247126115b1e&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;c71b4ce1-6b63-4ed6-b9c1-2ac8e24409e8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;粮农组织;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;a7a6db9b-a644-465c-a8b8-3a003735c4d2&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:36Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;c2899fa3-2e93-41c5-8000-5f033ce3a60b&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:36Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;94ba0952-b182-42d8-af37-111855ec4dbd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;0fc00a89-aad6-4d88-acc8-ab83502537f6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-04T14:06:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;868d2871-e68a-44ed-878d-1f6beaff3050&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;《2026年世界渔业和水产养殖状况》以实证为依据，提供最新信息，并提出深刻见解，剖析影响行业现状与未来的挑战、机遇及解决方案。2026年报告阐述粮农组织如何与成员、合作伙伴和关键利益相关方紧密协作，通过开展实地项目，将“蓝色转型”愿景转化为实效。本报告重点介绍各方为最大限度利用水产食品促进全球粮食安全、减贫和经济发展而付出的努力，包括加强政策宣导、推进科研创新、推进能力建设等方面。&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;20a93e42-b428-43b1-b14f-2b1c900f961a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;236 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;8a28531d-776d-4877-9b6f-409ce506bc