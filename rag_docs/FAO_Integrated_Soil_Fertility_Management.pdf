re/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;}},&q;_name&q;:&q;Principes généraux d’hygiène alimentaire&q;,&q;id&q;:&q;d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;,&q;uuid&q;:&q;d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e58031a3-a2ce-47ed-8d8d-6f4dd9fc893c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WHO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;b2d9090d-3b8d-41c4-a83b-77b0efacab07&q;,&q;language&q;:null,&q;value&q;:&q;2025-04-15T08:47:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;5778b9d1-e9cf-4d8e-b2b9-0144d98f7de8&q;,&q;language&q;:null,&q;value&q;:&q;2025-04-15T08:47:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;31b6d678-cbe2-413f-a400-22301f122722&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;bfcf2784-f180-4b97-8bee-29be73e3501b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-04-15T08:45:40Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;7f502855-604d-4720-90f8-c019e950a079&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Le présent document énonce les principes généraux qui devraient être compris et respectés par les exploitants du secteur alimentaire au long de la chaîne alimentaire, et constitue une base pour les autorités compétentes chargées de superviser la sécurité sanitaire et la salubrité des aliments.Cette édition contient une nouvelle annexe qui introduit des outils permettant de déterminer les points critiques pour la maîtrise dans un système d’analyse des dangers et points critiques pour leur maîtrise (HACCP).Le terme «Codex Alimentarius» vient du latin et signifie «code alimentaire». Les normes du Codex sont des textes ayant trait à l’alimentation au niveau international, c&s;est-à-dire des normes, des codes d&s;usages, des codes d&s;usages en matière d’hygiène, des lignes directrices et d’autres recommandations, établis pour protéger la santé des consommateurs et garantir des pratiques loyales dans le commerce des denrées alimentaires. L&s;ensemble des normes alimentaires et des textes apparentés adoptés par la Commission du Codex Alimentarius est connu sous le nom de Codex Alimentarius.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;3c855cd7-fad4-424e-93fc-74972b8b1240&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;60 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;7021a013-4e6c-44bb-9f2c-17cdf07447da&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cc6125fr&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;08239f05-01d5-45b5-8fd1-76efffdc3c67&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;French&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;e8a9ff43-69