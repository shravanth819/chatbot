knowledge.fao.org/server/api/core/items/8dca5edb-bf4b-40e9-a06f-83ae08bd31ce/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/8dca5edb-bf4b-40e9-a06f-83ae08bd31ce&q;}},&q;_name&q;:&q;La Situation mondiale des pêches et de l’aquaculture 2026&q;,&q;id&q;:&q;8dca5edb-bf4b-40e9-a06f-83ae08bd31ce&q;,&q;uuid&q;:&q;8dca5edb-bf4b-40e9-a06f-83ae08bd31ce&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;f7a9c745-b118-4d5d-9b76-762698384efe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;93a2237e-e520-4b0e-8f48-9e0fca1a588b&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:05:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;cfe55825-e97e-4a30-9be1-7a946e05a26e&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:05:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;b1b6465a-cee4-4eac-a7ec-cf0d3796292c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;1e1904b8-57e0-4986-9728-98c0bb8ec6fa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-04T14:03:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;330a2359-21e5-4a74-baf7-754f5e49e01c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;L’édition de 2026 de La Situation mondiale des pêches et de l’aquaculture fournit les informations et les analyses factuelles les plus récentes sur les défis, les opportunités et les solutions qui façonnent le présent et l’avenir du secteur. Le rapport montre comment la FAO traduit la vision de la transformation bleue dans des résultats concrets, par le biais des projets de terrain qu’elle mène en étroite collaboration avec ses membres, ses partenaires et les principales parties prenantes. Il présente les actions réalisées afin de maximiser la contribution des produits alimentaires d’origine aquatique à la sécurité alimentaire mondiale, à la réduction de la pauvreté et au développement économique, ainsi que les efforts déployés pour orienter les politiques, faire progresser la recherche scientifique et l’innovation, et favoriser le renforcement des capacités.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;d0a570b5-da43-4050-8b04-9a067925e5bf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;256 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;db1238f2-f18f-4d42-a0de-6d5d4eef8419&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8371&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;549f2abd-3eb0-40ee-8dcd-481b577865ed&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140838-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;7a11e779-75c8-47c0-90a3-a1cbd4d93146&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5497&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;ffc77ef4-edf0-4d6f-8de6-86e93379ac34&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8357fr&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;f3814105-3309-429c-a7de-5cd6f366a1cc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;French&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;7fa12722-08dc-4285-956c-6646f239ea66&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;9c69e542-d816-4315-9adf-6e61009b89ff&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;La situation mondiale des pêches et de l’aquaculture (SOFI