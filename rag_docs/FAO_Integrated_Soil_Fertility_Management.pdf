,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;937de0d3-1ed1-4f31-8036-7e8a3ded2d20&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CD8857EN&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.pws&q;:[{&q;uuid&q;:&q;0514fa35-85b5-4fc8-9222-aa57779260dc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;335810&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.initiator&q;:[{&q;uuid&q;:&q;cca4a982-2638-46c1-b5d4-5aaa31bf085c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Graham, Alison (OSG)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;57679cc4-6b27-400d-8e96-9fe7a80bbc46&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;OSG - Office of Sustainable Development Goals&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.placeofpublication&q;:[{&q;uuid&q;:&q;bce907ae-7333-440a-823b-dd9ba66c41d2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Rome, Italy ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.previewpage&q;:[{&q;uuid&q;:&q;e097a53d-f938-4657-aa2e-a8195f3a7694&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;p&g;The following FAO SDG briefs are available for download:&l;/p&g;&l;ul&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg1.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 1: End poverty in all its forms everywhere&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg2.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 2: End hunger, achieve food security and improved nutrition and promote sustainable agriculture&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg3.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 3: Ensure healthy lives and promote well-being for all at all ages&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg4.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 4: Ensure inclusive and equitable quality education and promote lifelong learning opportunities for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg5.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 5: Achieve gender equality and empower all women and girls&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg6.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 6: Ensure availability and sustainable management of water and sanitation for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg7.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 7: Ensure access to affordable, reliable, sustainable and modern energy for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg8.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 8: Promote sustained, inclusive and sustainable economic growth, full and productive employment and decent work for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg9.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 9: Build resilient infrastructure, promote inclusive and sustainable industrialization and foster innovation&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg10.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 10: Reduce inequality within and among countries&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg11.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 11: Make cities and human settlements inclusive, safe, resilient and sustainable&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg12.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 12: Ensure sustainable consumption and production patterns&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg13.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 13: Take urgent action to combat climate change and its impacts&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg14.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 14: Conserve and sustainably use the oceans, seas and marine resources for sustainable development&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg15.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 15: Protect, restore and promote sustainable use of terrestrial ecosystems, sustainably manage forests, combat desertification, and halt and reverse land degradation and halt biodiversity loss&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg16.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 16: Promote peaceful and inclusive societies for sustainable development, provide access to justice for all and build effective, accountable and inclusive institutions at all levels&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg17.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 17: Strengthen the means of implementation and revitalize the Global Partnership for Sustainable Development&l;/a&g;&l;/li&g;&l;/ul&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.sdgs&q;:[{&q;uuid&q;:&q;b11a01d7-5b5d-4789-bdf8-4b10f5275e08&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;01. End poverty in all its forms everywhere&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;8b0490b4-25cd-43c5-9637-a0ab59e18758&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;02. End hunger, achieve food security and improved nutrition and promote sustainable agriculture&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;e9bab356-30aa-4210-9a07-d811233c9862&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;03. Ensure healthy lives and promote well-being for all at all ages&q;,&q;place&q;:2,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;57c7fc61-d307-486f-b4dd-ec3205042f19&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;04. Ensure inclusive and equitable quality education and promote lifelong learning opportunities for all&q;,&q;place&q;:3,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;becc5ccd-3df1-43c2-aa17-3b184dfd8679&q;,&q;language&q;:&q