iennial Transparency Reports of the countries of Europe and Central Asia&q;,&q;id&q;:&q;3a1a6dad-beac-4d19-bf76-4f6de874954f&q;,&q;uuid&q;:&q;3a1a6dad-beac-4d19-bf76-4f6de874954f&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;95b66175-e272-4026-84e8-92a3549d61fa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Kvasha, A.; Van ‘t Wout, T.;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;ee827b88-8b02-43e7-8fe6-56b95525e8f9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Europe&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;0f93f139-2a2a-4c37-b82e-c3659ea0b1e9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Central Asia&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;37d0d4a4-1602-4077-b33e-690ba76954a2&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T17:00:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;6df29ed3-16f1-47bf-96d1-2281a7424e5b&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T17:00:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;710ca125-2fc1-4324-895c-7cf4abf6c125&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;09e0bc7e-b08f-4b26-ac37-d9089922b662&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-14T16:58:05Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;f606a973-9c7d-4189-9072-572fe0c3b08a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This publication reviews how loss and damage in agriculture are reflected in the first Biennial Transparency Reports submitted by countries in Europe and Central Asia under the Enhanced Transparency Framework of the Paris Agreement. Covering 18 countries across the Caucasus, Central Asia, Commonwealth of Independent States Europe and Ukraine, the Western Balkans and Türkiye, the analysis examines the use of loss and damage terminology, the types of extreme weather and slow-onset events reported, the availability and consistency of quantitative and qualitative data, and the climate change adaptation and disaster risk reduction measures described in relation to agriculture. The findings of the review indicate that countries are already using Biennial Transparency Reports to document, to varying degrees, climate-related impacts on agriculture, including across crops, livestock, forestry, fisheries and aquaculture. However, reporting remains uneven in scope, terminology and level of detail. Extreme weather events are generally better captured than slow-onset processes, while quantified information on economic losses and damages is more common than evidence on non-economic impacts. The publication highlights the need for clearer conceptual alignment between climate change-induced loss and damage reporting and disaster risk reduction assessment and monitoring frameworks, stronger sectoral data systems, improved methodologies and tools for assessing impacts on agrifood systems, and enhanced institutional capacities and coordination. By identifying current reporting practices, gaps and opportunities, this publication aims to support countries, practitioners and partners in strengthening evidence-based, risk-informed decision-making and informing climate change adaptation, disaster risk reduction and agrifood system planning and policy processes, while improving transparency reporting on climate-related loss and damage in agriculture.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;eb306867-7631-40de-82b9-92efb465409f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;44 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;b182120b-e9cc-4f47-a670-b9e3e0f65e8c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140831-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;4ee8fad5-a4bb-4bad-a518-550360d83e56&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0473en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;85732bac-1586-4eef-b069-65906502dda6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;42363943-3fbb-4483-b7e1-bcba4e8351dd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;c067d734-74dd-4684-8069-d34de4637092&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;76708737-13a4-4a54-981c-133f7ffc2cb6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;d0a66d8b-b2d7-4bf6-8f02-81040d49207b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Review of the Biennial Transparency Reports of the countries of Europe and Central Asia&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;265a1075-3901-4016-93cc-a29dbb239d86&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Loss and damage in agriculture&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;341010f7-20c3-49d4-926f-2a558b7c302d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;3f67aa13-b480-4666-93e6-6111f83d474c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.citation&q;:[{&q;uuid&q;:&q;ee8011bc-5c4d-4308-b0ce-6ba26adfa85a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;div cl