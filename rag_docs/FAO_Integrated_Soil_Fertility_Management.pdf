0b6f09941c&q;,&q;language&q;:null,&q;value&q;:&q;2025-01-08T13:17:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;aaef16d9-a2ca-4512-b5ca-ef1f501ef751&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2024&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;2984e221-0801-4740-9e1e-d52803ebb12e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-01-08T13:05:57Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;0fa2b49a-be3d-4ad7-b9d7-ed83c8b6b6e5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Statistical Yearbook 2024 offers a synthesis of the major factors at play in the global food and agricultural landscape. Statistics are presented in four thematic chapters, covering the economic importance of agricultural activities, inputs, outputs and factors of production, their implications for food security and nutrition and their impacts on the environment. The Yearbook is meant to constitute a primary tool for policymakers, researchers and analysts, as well as the general public interested in the past, present and future path of food and agriculture.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;da8aa2a3-911f-420c-8403-d6d1113e41fe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;384&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;20eb5a92-a1a0-426a-89d9-c713b38ad064&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-139255-3&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;8dad6db8-8fd7-40ba-901b-786f5f6b0b4d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2225-7373&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;c8dd2f0f-4e28-4adb-9512-6a1054e989f7&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd2