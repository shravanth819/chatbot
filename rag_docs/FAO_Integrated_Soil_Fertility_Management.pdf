rg/server/api/core/items/9cc40cb9-a207-4a7e-b75a-8290d6a04e98/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9cc40cb9-a207-4a7e-b75a-8290d6a04e98/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9cc40cb9-a207-4a7e-b75a-8290d6a04e98/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9cc40cb9-a207-4a7e-b75a-8290d6a04e98/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9cc40cb9-a207-4a7e-b75a-8290d6a04e98/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9cc40cb9-a207-4a7e-b75a-8290d6a04e98&q;}},&q;_name&q;:&q;El estado mundial de la pesca y la acuicultura 2026&q;,&q;id&q;:&q;9cc40cb9-a207-4a7e-b75a-8290d6a04e98&q;,&q;uuid&q;:&q;9cc40cb9-a207-4a7e-b75a-8290d6a04e98&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;48979ba3-c2fb-447a-89ed-239413e4a7ba&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;66511421-c541-464f-bac5-ad7617f7839c&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:25Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;4695b251-797e-45d8-86c9-1be43d0ebc01&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:25Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;37ccaddb-c6b0-4823-bd9c-e767e9ffe134&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;56e97231-4799-4738-aa24-f0e0b031cfc7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-04T14:04:35Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;a72e1395-9db7-4349-b3d4-16c4b0ea1f73&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;En El estado mundial de la pesca y la acuicultura 2026 se ofrece información y perspectivas basadas en los datos objetivos más recientes sobre los desafíos, las oportunidades y las soluciones que determinan el presente y el futuro del sector.En la presente edición de 2026 se muestra cómo traduce la FAO la visión de la transformación azul en repercusión mediante la ejecución de proyectos sobre el terreno en estrecha colaboración con sus Miembros y asociados y con partes interesadas clave. Asimismo, se ponen de relieve las iniciativas orientadas a potenciar al máximo la contribución de los alimentos acuáticos a la seguridad alimentaria, la mitigación de la pobreza y el desarrollo económico a nivel mundial mediante un incremento de la promoción de políticas, avances en la investigación científica y las innovaciones y el fomento del desarrollo de la capacidad.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;06d5229b-a2a0-404b-8550-941f24095090&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;254 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;617ff8f3-1206-4713-9bd2-c47609446fe9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8649&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;0bc7832d-1c1c-4de0-ac93-4017c7058632&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140837-7&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;7dca0484-8376-48e8-8e33-5ea23815afb5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5500&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;ff266183-dd78-4ef6-924c-a0c154a89055&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8357es&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.lan