nce&q;:-1}],&q;fao.identifier.doi&q;:[{&q;uuid&q;:&q;252cfbec-a117-42aa-a254-a2c301e9bb4d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;https://doi.org/10.4060/ce0204en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;f9b80d89-35a8-4135-a76f-5a24944b7322&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CE0204EN&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.pws&q;:[{&q;uuid&q;:&q;cac6db21-fcc5-4dda-8ea5-7ee3836e5862&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;334189&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.initiator&q;:[{&q;uuid&q;:&q;973fb131-2922-4b37-8d1c-f753b9b77559&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Mostafapour, Ameneh (EST)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;03e90888-5b5d-4273-9ada-81c7ae5e9daf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;EST - Markets and Trade&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.placeofpublication&q;:[{&q;uuid&q;:&q;c4d2a7a0-2374-4c1d-b56f-b11a23f83174&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Rome, Italy ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.previewpage&q;:[{&q;uuid&q;:&q;8416678e-f744-4066-8a40-4868ec0b5e9d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;p&g;&l;b&g;Markets at a Glance&l;/b&g;&l;/p&g;&l;ul&g;&l;li&g;&l;b&g;&l;i&g;Cereals&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global cereals market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_cereals.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Wheat&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global wheat market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_wheat.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Coarse Grains&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global coarse grains market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_grains.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Rice&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global rice market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_rice.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Oilcrops, oils and meals&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global oilcrops market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_oilcrops.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Sugar&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global sugar market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_sugar.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Meat and meat products&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global meat market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_meat.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Milk and milk products&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global milk market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_milk.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Fish and other acquatic products&a;nbsp;&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global fish market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_fish.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;br&g;&l;/a&g;&l;/b&g;&l;/ul&g;&l;p&g;&l;/p&g;&l;p&g;&l;b&g;Special feature&l;/b&g;&l;/p&g;&l;p&g;&l;i&g;Using alternative fuels for international maritime shipping: implications for Small Island Developing States&l;/i&g;&l;/p&g;&l;p&g;Maritime shipping is accelerating trials of alternative fuels, driven by the International Maritime Organization’s (IMO) pathway to decarbonize the internationalmaritime sector. &l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_special_feature1.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g;Read it here&l;/a&g;&l;/b&g;&l;/p&g;&l;p&g;&l;i&g;&l;br&g;Energy market uncertainty and ethanol–sugar price linkages&l;/i&g;&l;/p&g;&l;p&g;Energy markets, which are naturally volatile, have faced even greater uncertainty, driven by price swings, geopolitical risks, and an uneven energy transition. &l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_special_feature2.pdf\&q;&g;Read it here&l;/a&g;&l;/p&g;&l;p&g;&l;i&g;&l;br&g;Fertilizer market update&l;/i&g;&l;/p&g;&l;p&g;The Fertilizer Market Update reviews global fertilizer production, utilization, and trade in 2025, and then examines separately the disruptions and market developments that intensified in early 2026. &l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_special_feature3.pdf\&q;&g;Read it here&l;/a&g;&l;/p&g;&l;p&g;&l;i&g;&l;br&g;&l;/i&g;&l;/p&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.sdgs&q;:[{&q;uuid&q;:&q;da24cb38-d948-4fbc-b887-cf38a684c8c9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;01. End poverty in all its forms everywhere&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.specialapprover.identifier&q;:[{&q;uuid&q;:&q;65a1d63f-9d07-425c-b1a8-d139e11b5bde&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;17&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.subject.agrovoc&q;:[{&q;uuid&q;:&q;5558dac0-08ca-4bf3-b897-f81a697021c4&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;commodity markets&q;,&q;place&q;:0,&q;authority&q;:&q;8718bc88da6d00da6e92a1e8a45adf3b27ceb552&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;3f804217-877d-4c6d-881d-8a3307a26c68&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;crop production&q;,&q;place&q;:1,&q;authority&q;:&q;f6b6cf227ca7413f28d8c5ec5c9e07d805acabc9&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;3ebc0c16-e03a-4622-b82f-7a0e51830fbb&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;crop forecasting&q;,&q;place&q;:2,&q;authority&q;:&q;7089b9496923574a7330690fbc4431abd9e887b7&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;5e92f952-9721-48fb-8612-7b388673d83a&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;trade policies&q;,&q;place&q;:3,&q;authority&q;:&q;5d26b70276bf0777b63e1ddd20cbcfcb0c6b6495&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;afbd5b84-1919-44dd-9501-d497883bf71