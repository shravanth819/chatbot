q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;d3441d43-b4c8-4172-80bd-a3f6bb233821&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T12:15:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;11badc62-adaa-494c-ac43-5343e8cba09c&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T12:15:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;9675c823-816f-448a-bdf2-a9a0918fc38f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;42129f91-5dd3-4d31-b189-8ba1c1e08700&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-14T12:13:36Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;aa940aca-0052-49ee-803b-b6ac38944b60&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Agrosilvopastoral systems can contribute to food security, resilient livelihoods, biodiversity, climate adaptation and sustainable land management. Yet they are often reduced to simplified practice, such as grazing under trees or adding trees to livestock and farming landscapes; this brochure examines 12 common misconceptions about agrosilvopastoral systems and explains how evidence, policy and practice can overcome them. It presents these systems as deliberately managed socio-ecological systems linking forests, trees and shrubs, rangelands, crops and forage, livestock and other animal species, people, knowledge systems, institutions and value chains. It highlights managed interactions, multifunctionality, biodiversity, social diversity, tenure, mobility and equitable participation, and concludes with five principles for moving from isolated interventions towards locally adapted and inclusive system transformation.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;28e68867-c652-473c-90cc-13bdc8b123a2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;35 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;1ad67580-f665-4db5-a435-e6400eed9a8c&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce1144en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;028ecfbd-f83c-4dd2-99ef-bf4a14251509&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;2283f81e-01fb-4771-ac70-cd1615bb60e0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;60aa11e4-ccaf-47ae-ab94-0c281f167b4d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;e979215e-b23c-4998-a665-55f25ff62a4d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;9835ad3b-a72f-4813-8fc8-b1eff1877887&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Twelve misconceptions about agrosilvopastoral systems – and how to overcome them&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;d71a88f5-5b94-4dea-bc1a-92756cb2d277&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Brochure, flyer, fact-sheet&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;d89fc0f9-0234-4d57-8253-dbcb1a2e0735&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.date.available&q;:[{&q;uuid&q;:&q;2e223113-8526-49f7-812c-4b46b689bb53&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-13T22:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargo&q;:[{&q;uuid&q;:&q;58e48662-eadf-4751-aba8-563d1f0e1e69&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;