tadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e5ccbb16-97c2-4cd4-9816-826e2d91551d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;12d8fa33-6e7d-4490-85d6-9a4aefce6b67&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-27T16:11:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;dad89472-1eec-46b8-830b-8f0251d71484&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-27T16:11:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;7129b378-63ee-4e13-ae0e-93ca81511e5f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;657d2562-7697-4705-9268-420046ac95c0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-05-27T16:02:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;5a4b0570-be48-4a1a-a318-d309d0c28554&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO and the SDGs – Accelerating transformation through the four betters provides a comprehensive overview of how transforming agrifood systems can drive progress across the entire 2030 Agenda for Sustainable Development. Drawing on FAO’s mandate and the Strategic Framework 2022–2031, the publication highlights the central role that sustainable, inclusive and resilient agrifood systems play in addressing global challenges such as hunger, poverty, inequality, climate change and environmental degradation.The publication brings together 17 concise briefs, one for each Sustainable Development Goal (SDG). Each brief outlines the relevance of agrifood systems to the Goal, presents key global trends and challenges, and highlights FAO’s areas of action and support to Members. It also identifies priority actions, innovations and partnerships needed to accelerate progress, offering practical entry points for governments and partners working to advance sustainable development.Together, the briefs show how progress on the SDGs is deeply interconnected with agrifood systems transformation. Framed through FAO’s four betters – better production, better nutrition, better environment and a better life – the publication presents an integrated roadmap for accelerating action across all 17 SDGs, while ensuring that agrifood systems contribute to a more sustainable, resilient and inclusive future.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;bb823e9c-00f2-494c-af19-2975e34fbfc4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;162 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;670cd4ac-3801-49d2-9e97-e7e7d8cb083a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140625-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;1a79b0fe-c4d7-4dfd-992f-dcff2d240264&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8857en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;4a0f0185-fbd6-4fd0-b1ac-4233871071bf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;9a122136-2e41-48f3-b7fb-3eb20412a9e5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;3b1a9cc0-b851-4f4e-bb61-922079c69570&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;89454ed0-2782-4c59-92df-fe2af1dd5070&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;12f9757a-5a26-4333-8627-52e3fa91fef8&q;,&q;language&q;:&q;&q;,&q;v