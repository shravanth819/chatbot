emlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/b828688a-34d5-4e08-8421-423f57b81c87&q;}},&q;_name&q;:&q;Guidance for conducting financial performance reviews of fishing fleets&q;,&q;id&q;:&q;b828688a-34d5-4e08-8421-423f57b81c87&q;,&q;uuid&q;:&q;b828688a-34d5-4e08-8421-423f57b81c87&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e014c45f-1f38-4f11-8db7-39709c40fb6e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Kitts, A.;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;826ec6f5-4601-4be9-881c-b8e06d81d21b&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T13:00:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;de0086d7-ede1-4d55-9c6a-6f6b07de4b11&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T13:00:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;895113df-6652-4fc5-ad5b-474bee4cc19e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;a5743c16-9746-4ad5-aa3e-a07ae5e3f917&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-14T12:58:43Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;ccd2c090-8d7f-4488-b893-0cdb17b078e3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This circular presents guidance for conducting financial performance reviews of fishing fleets as part of the next generation of FAO techno-economic fleet performance assessments. Building on previous FAO Techno-economic fleet performance reviews and best practice guidance from the National Oceanic and Atmospheric Administration of the United States of America, it introduces revised definitions for revenues, costs and financial indicators to improve consistency and comparability across countries and fleet segments. The methodology proposed adopts harmonized financial reporting based on income statement and cash flow approaches and incorporates new indicators, including earnings before interest, taxes, depreciation and amortization (EBITDA), return on fixed assets, fuel intensity and fuel efficiency, while simplifying asset valuation and depreciation.The circular also includes a practical training manual to support fisheries economists and data collectors in survey design, collecting representative vessel-level financial data and applying standardized definitions for revenues, labour, running, vessel, overhead and capital costs. The detailed guidance is complemented by two Excel-based tools for vessel- and fleet-level data entry that automatically generate financial statements and calculate standardized indicators. Together, the methodology, training manual and Excel-based tools provide a practical framework for producing reliable, internationally comparable financial performance profiles of fishing fleets to support fisheries management and policy development.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;36910b0b-5166-47fc-8ca8-f6a075f83478&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;26 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;20687c0a-98f5-49a5-a2f8-ccd4f9993183&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140919-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;aec17c00-0414-4023-bd96-a59ffcc29249&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2070-6065&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;ee5bdc2c-3d76-4113-b9f0-6c908c7abc18&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce1048en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;1cdc5437-4c26-440a-8180-9cae48ae3661&q;,&q;lang