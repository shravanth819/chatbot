09-9671-4db9-b494-66ca2155c39d/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6b19b909-9671-4db9-b494-66ca2155c39d/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6b19b909-9671-4db9-b494-66ca2155c39d/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6b19b909-9671-4db9-b494-66ca2155c39d/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6b19b909-9671-4db9-b494-66ca2155c39d/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6b19b909-9671-4db9-b494-66ca2155c39d&q;}},&q;_name&q;:&q;Highlights of science and innovation in FAO’s work&q;,&q;id&q;:&q;6b19b909-9671-4db9-b494-66ca2155c39d&q;,&q;uuid&q;:&q;6b19b909-9671-4db9-b494-66ca2155c39d&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;6637d1c7-5e62-4795-bce9-e6f0945490ad&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;7d6475f8-8df2-4684-b5c1-e16ef5b0e24d&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-26T09:20:27Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;caa41666-ec3c-4b59-b7ab-8e56fea206b0&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-26T09:20:27Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;cc3e393e-1c7d-4340-b825-621fb8955bb1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;118909e0-d02f-4bc4-bb40-ac083481ef33&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-26T09:15:07Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;2338efb5-d8a2-47af-8231-8c3582b64b30&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Highlights of science and innovation in FAO’s Work report was developed to illustrate the breadth and depth of science and innovation in FAO’s efforts. The FAO Science and Innovation Strategy is a key tool to support the implementation of the FAO Strategic Framework 2022-31. The report presents examples of FAO&s;s work that reflect the Strategy’s broad scope, inclusive of all scientific disciplines and all types of innovation. The examples span FAO’s work -- from enhancing productivity to healthy diets and reducing food loss and waste, from strengthening agricultural extension and advisory services to harnessing better data and digital agriculture, from One Health to adapting to climate uncertainty, from prevention and early warning to scaling investments and development of global and regional platforms for sharing data, among others.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;aa86c133-7eae-4f1f-866d-9dbd3f9b8638&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;71 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;74c88f8c-40ef-43f6-87de-ebedb3efa29c&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8352en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;30a35646-73ab-4e4b-9133-ac63d6bd123c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;f256266e-9d25-4e99-8735-0011b3714a76&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;7372e276-309b-409a-9203-0361d706d9a3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;d3111824-b2e5-404b-89f7-c0b004a9b118&q;,&q;languag