e/items/13d2a2f1-4910-4225-ac53-da5c20c29c18/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13d2a2f1-4910-4225-ac53-da5c20c29c18/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13d2a2f1-4910-4225-ac53-da5c20c29c18/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13d2a2f1-4910-4225-ac53-da5c20c29c18&q;}},&q;_name&q;:&q;The status of women in agrifood systems in sub-Saharan Africa&q;,&q;id&q;:&q;13d2a2f1-4910-4225-ac53-da5c20c29c18&q;,&q;uuid&q;:&q;13d2a2f1-4910-4225-ac53-da5c20c29c18&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;f1ab65a8-ac74-410f-8161-7c799849c3de&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; NRI; AWARD;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;999efdb1-77b3-4ed4-bf30-e0964a3bb760&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Africa&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;4e7584ce-44ad-40b3-acf3-ac43528b4247&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-11T11:50:47Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;63e94121-d099-4d44-a48e-3b73304b0cbb&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-11T11:50:47Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;8c500d7b-b673-4e18-92ec-f4b3e07ff9e0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;a6c52cbc-c55f-49c9-980f-e7ed946733be&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-05-11T11:49:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;d44972f9-a482-4427-bc6c-8020ec5b37bc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The status of women in agrifood systems in sub-Saharan Africa provides the latest data, policy highlights and recommendations for policy- and decision-makers about gender in agrifood systems in sub-Saharan Africa. The report reviews and analyses women’s opportunities and constraints in economic and social processes in sub-Saharan Africa, while taking stock and assessing progress made in closing a series of gender gaps. It provides new directions, examples of policies and good practices that promote gender, climate and environmentally just agrifood systems in sub-Saharan Africa.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;fb7b6366-ea11-4147-9401-cb02dc80d7d5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;274 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;5e1f3456-a337-4acc-a558-e00ae1ab1cf2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140633-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;ecc79d52-e1dd-47c6-a467-ab7c2690dd98&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9262en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;2e8caa42-5387-481f-883f-8314a5a21018&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;2c304467-9d27-4d51-aaf9-b7045d19f1fd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; African Women in Agricultural Research and Development (AWARD) ; Natural Resources Institute of University of Greenwich (NRI) ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;39ff5990-4614-406d-ac9c-5e0abe6607f1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;819c3e74-0c02-494c-9a4e-fd01285c3475&q;,