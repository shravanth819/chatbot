},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332&q;}},&q;_name&q;:&q;Extreme heat and agriculture&q;,&q;id&q;:&q;f635e477-b37a-46f8-bc10-34d56cec6332&q;,&q;uuid&q;:&q;f635e477-b37a-46f8-bc10-34d56cec6332&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e413bad2-2d57-47ef-9631-2874908eb7c5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WMO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;0d7ab093-cabd-4110-a197-96dc42126e66&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-22T07:40:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;d18334a8-95e5-46c4-a5f7-ffd43befeaa3&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-22T07:40:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;42e6f8f6-545a-4839-a7d4-8a9843dd4883&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;70ab302c-8927-487d-932c-02ece32862f2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-04-22T07:36:05Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;3223563f-94a8-4d57-8f97-efc7a86d2cb2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Extreme heat is emerging as one of the most urgent and least understood threats to agriculture and food security. Rising temperatures, prolonged heatwaves, and shifting climate patterns are already disrupting crop yields, livestock health, water availability, and rural livelihoods – with impacts falling disproportionately on the most vulnerable.Because extreme heat is predictable, strengthening climate services and early warning systems linked to anticipatory actions is a key opportunity. It is also clear that there are profound limits to what adaptation can achieve. With global mean temperatures on the cusp of exceeding the 1.5 °C warming limit outlined in the Paris Agreement, the urgency for adaptation and mitigation action only grows. The only durable solution to protect the future of global agrifood systems from the escalating threat of extreme heat lies in ambitious, multilateral climate change mitigation.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;85c605a3-1c48-47da-9328-f9ef9120a3b5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;108 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;60a287f0-047f-481a-8e06-9142ec4234cc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140656-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;e4c93898-11a4-4557-8e17-6a3cc43aba30&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9394en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;2bdff225-559a-422e-851c-384e528af770&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;2963b90f-3bf8-45dd-8e93-be6c91cc4bf8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; WMO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;c3e8ebe8-eeb5-40ea-ac82-51fc17b2b28b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Shared&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;7c07f9a6-1a25-44d5-b5d4-d16b13f44e08&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;347a95c7-54af-4f5e-bb59-35142d5242ff&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Extreme heat and agriculture&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;35dabdbe-c840-499