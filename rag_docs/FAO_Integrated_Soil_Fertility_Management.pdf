035f-49ad-baf9-7226acddd164&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;cb22345c-0b92-4810-b42e-77bf5da9c4a5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-25T07:46:12Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;455a57f8-fefb-41cd-9438-8142ac54b6ca&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;A joint FAO and Bauhaus technical report examining how greater adoption of engineered wood products (EWPs) in construction could contribute to climate change mitigation. Using the FOROM global forest model, the report runs multiple scenarios out to 2070, testing different urbanization and wood-use assumptions, to project future EWP demand, estimate carbon storage and emissions substitution benefits, and benchmark results against national climate commitments (nationally determined contributions). Even under conservative assumptions, the findings point to EWPs as a credible and scalable climate strategy within a sustainably managed forest-based bioeconomy.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e2dc2225-0e24-4923-954e-c8bf5234806f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;142 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;5bf219ab-c6b7-4c53-90b8-07b4848b2255&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140786-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;4ea4009a-2bb8-4f02-8ae2-da401ce19888&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0315en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;87bcb7d5-1f42-4a6a-b58e-614e4225c163&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q