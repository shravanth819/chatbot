onfidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;5d97d4a8-14e7-4914-a7c5-fa429e912baf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-10-14T09:13:03Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;f8bc001f-639e-4edb-a0e1-9c7effedc42a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;From the State of the World collection and other major reports to freshly penned technical studies, FAO publications cater to a diverse range of audiences. This catalogue presents a selection of FAO’s main publications, produced in 2025 or earlier, ranging from its global reports and general interest publications to numerous specialized titles. In addition to the major themes of agriculture, forestry and fisheries, it also includes thematic sections on climate, economic and social development, and food safety and nutrition.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;c58da81a-751c-476f-a0b5-30d03c12c472&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;104 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;bc27c7cb-910d-40c5-a94a-ae0905533a54&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140161-3&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;6337b354-a44b-4127-85a6-f419e1c45616&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd7085en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;370d4705-5381-4d95-a19f-232f3d20e079&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;ab183f64-c132-4808-b305-dc7b4a3b3d2a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;76a19b95-98bd-495e-88fa-d1f3cb840bdb&q;,&q;la