.date.accessioned&q;:[{&q;uuid&q;:&q;19557087-b9c3-4f30-9e11-21de8a98bdd9&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:30Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;b5b94c9e-e7b4-4db5-8d9f-4b41159484fd&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:30Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;d7eec1fe-bbf3-408a-a393-f0af8ce3f43f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;8c18f626-eb18-467d-816c-66bde3a94b23&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-04T14:07:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;40c98536-adb3-435a-b733-dd1dae68f822&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;В докладе \&q;Состояние мирового рыболовства и аквакультуры  – 2026\&q; приводятся наиболее актуальные фактологически обоснованные сведения и выводы о проблемах, возможностях и решениях, влияющих на настоящее и будущее сектора. В выпуске 2026 года демонстрируется, как ФАО претворяет в жизнь инициативу \&q;Голубая трансформация\&q;, реализуя проекты на местах в тесном сотрудничестве с членами, партнерами и ключевыми заинтересованными сторонами. Особое внимание в нем уделяется усилиям, направленным на повышение вклада систем производства пищевой продукции из водных биоресурсов в обеспечение глобальной продовольственной безопасности, сокращение масштабов нищеты и экономическое развитие, а также на активизацию информационно-просветительской деятельности в области политики, содействие научным исследованиям и инновационной деятельности и дальнейшее укрепление потенциала.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;51f3885a-c740-4a9e-95e7-766debf3655f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;237 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;5b94138c-05f0-4466-a982-2a11851c9387&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8657&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;a3591a53-8902-4ab3-ba18-8a7018012426&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140836-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;a0a7ae82-da25-4b67-b387-1ea21983a1a4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2070-6197&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;f24b3522-429d-4eed-8288-994af7f02298&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8357ru&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;34ca458c-1170-4012-a070-70f42a3a7dbd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Russian&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;5af036c3-412f-4cd5-ac7f-3d16cc6060d4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;ФАО ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;2d49c418-8d2c-42a2-9a43-91f075a3577f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;СОСТОЯНИЕ МИРОВОГО РЫБОЛОВСТВА И АКВАКУЛЬТУРЫ&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;385ba48a-2819-4433-aa71-1566a42fb11c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;dd9ae60a-5fcd-4266-a285-c995130c23ed&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;63061583-a462-4d66-ba16-b837d5df2d22&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;