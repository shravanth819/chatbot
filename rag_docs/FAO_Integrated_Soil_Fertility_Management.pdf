ts&q;,&q;id&q;:&q;9054dd1a-e9eb-456e-88f7-c6ab657f22ad&q;,&q;uuid&q;:&q;9054dd1a-e9eb-456e-88f7-c6ab657f22ad&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e74aeaff-1e24-467c-a0da-b944eb092a72&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;4a566746-780c-459a-be8d-f0a37122b355&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-18T08:45:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;21de274b-b4b1-4433-a06a-712d7df5dbff&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-18T08:45:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;5ad74909-2916-46c9-aef0-1b3bb01e4695&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;7f80365f-2fee-49eb-8adc-1d170268927a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-18T08:39:42Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;3a84f585-a480-4bf3-893d-9b486da08618&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Despite spillovers from energy and fertilizer markets into agriculture, FAO’s latest assessments point to a still relatively favourable outlook for global food commodity markets. Cereal production is expected to ease from record highs but remain at historically elevated levels. Nevertheless, the outlook remains highly contingent on weather developments, including emergence of El Niño, which continue to pose significant risks to production. At the same time, rising conflicts and geopolitical tensions, uncertainty surrounding trade policies, as well as broader macroeconomic headwinds, weigh on trade prospects and market stability.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e48c0a3a-0509-4d5f-91de-5dbf0869b503&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;137 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;7de8c7ef-3e3e-42c4-ae04-c9098f38d96e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1560-8182&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;0d688012-ea49-453e-a6c2-6c50933bbb90&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140448-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;2d866014-4309-4cf0-a04d-e9f66f473ef4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;0251-1959&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;a1e78775-80e0-418c-9e1a-63d0f70cf6e6&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0204en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;cf39fd69-61e8-4358-a10b-7d96800eb00a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;3646ea82-12e9-42b0-b801-981a23f849fc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;fe507bbb-0d14-4142-ad03-18e7fb5914ef&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Food Outlook&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;a97c97e5-a41b-4a68-8e04-07e42be40c31&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;June 2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;e28e3b47-29f7-41bf-bc1a-f1213e324974&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;0a07baef-5962-4129-8980-987acaf918ac&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;: