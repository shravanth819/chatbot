   photoshop:Country="KENYA"
   photoshop:CaptionWriter="AV/sk"
   photoshop:Headline="Farmer Field Schools in Kenya"
   photoshop:Credit="Â©FAO/Ami Vitale"
   photoshop:Source="FAO: photo-library@fao.org"
   photoshop:DateCreated="2003-11-04"
   photoshop:City="Narok"
   photoshop:Instructions="&amp;nbsp;"
   photoshop:ColorMode="4"
   photoshop:ICCProfile="U.S. Web Coated (SWOP) v2"
