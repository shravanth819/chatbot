   <dc:subject>
    <rdf:Bag>
     <rdf:li>Africa</rdf:li>
     <rdf:li>Animal husbandry</rdf:li>
     <rdf:li>Cattle</rdf:li>
     <rdf:li>Cows</rdf:li>
     <rdf:li>Farmer Field Schools FFS</rdf:li>
     <rdf:li>Food Security</rdf:li>
     <rdf:li>Herds</rdf:li>
     <rdf:li>Initiative on Soaring Food Prices ISFP</rdf:li>
     <rdf:li>Kenya</rdf:li>
     <rdf:li>Livestock</rdf:li>
     <rdf:li>Maasai</rdf:li>
     <rdf:li>Pastoral society</rdf:li>
     <rdf:li>Rural communities</rdf:li>
